{
  "manifest_version": 3,
  "name": "Photon — Everywhere",
  "version": "0.1.0",
  "description": "Lets Photon count your time across every tab, not just its own. Nothing leaves your computer.",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://photon.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Photon — counting across your tabs" }
}
